# ===================================================
# FuelTracks Technologies - Inventory Management System
# Production Environment Configuration
# ===================================================

# Node environment: 'production' or 'development'
NODE_ENV=production

# Server HTTP Port
PORT=5000

# Directory where persistent database and backups will be stored
# On Docker/Cloud VPS, point this to a persistent volume mount path (e.g. /var/data or ./backend/data)
DATA_DIR=./backend/data

# ===================================================
# Free Cloud Persistence Sync (For Render Free Tier)
# Use Cloudflare R2 (10GB Free Forever) or Supabase S3 (1GB Free Forever)
# ===================================================
# S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
# S3_BUCKET=ims-database-backup
# S3_ACCESS_KEY_ID=<your-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-secret-access-key>
# S3_REGION=auto
# S3_DB_KEY=inventory.db

